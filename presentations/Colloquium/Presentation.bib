@article{penttilaFlatbandRatioQuantum2025,
  title = {Flat-Band Ratio and Quantum Metric in the Superconductivity of Modified {{Lieb}} Lattices},
  author = {Penttilä, Reko P. S. and Huhtinen, Kukka-Emilia and Törmä, Päivi},
  date = {2025-01-31},
  journaltitle = {Communications Physics},
